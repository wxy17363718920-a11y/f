def lan_qr_svg():
    port = request.host.split(":")[-1] if ":" in request.host else "8000"
    url = f"http://{get_lan_ip()}:{port}"
    if not QR_AVAILABLE:
        return Response("", status=404)
    qr = qrcode.QRCode(border=2)
    qr.add_data(url)
    qr.make(fit=True)
    mat = qr.get_matrix()
    n = len(mat)
    rects = "".join(
        f'<rect x="{c}" y="{r}" width="1" height="1"/>'
        for r, row in enumerate(mat)
        for c, val in enumerate(row) if val
    )
    svg = (
        f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {n} {n}" shape-rendering="crispEdges">'
        f'<rect width="{n}" height="{n}" fill="#ffffff"/>'
        f'<g fill="#000000">{rects}</g></svg>'
    )
    return Response(svg, mimetype="image/svg+xml")


@app.route("/api/upload", methods=["POST"])
def upload_media():
    cleanup_old_files()
    file = request.files.get("file") or request.files.get("video")
    if not file:
        return jsonify({"error": "未找到上传文件"}), 400
    if not file.filename:
        return jsonify({"error": "文件名为空"}), 400

    ext = Path(file.filename).suffix.lower()
    if ext in ALLOWED_VIDEO_EXTENSIONS:
        media_type = "video"
        if not check_ffmpeg_installed():
            return jsonify({"error": "处理视频需要安装 ffmpeg 和 ffprobe"}), 500
    elif ext in ALLOWED_IMAGE_EXTENSIONS:
        media_type = "image"
    else:
        return jsonify({"error": "不支持的格式，请上传 MP4/MOV/WebM/MKV/AVI 视频或 JPG/PNG/WebP 图片"}), 400

    file_id = uuid.uuid4().hex
    saved_name = f"{file_id}{ext}"
    saved_path = UPLOAD_DIR / saved_name
    file.save(saved_path)

    try:
        meta = probe_video(saved_path) if media_type == "video" else probe_image(saved_path)
    except Exception as exc:
        saved_path.unlink(missing_ok=True)
        return jsonify({"error": f"解析文件信息失败: {exc}"}), 400

    with FILE_LOCK:
        FILE_INDEX[file_id] = {
            "path": saved_path,
            "filename": saved_name,
            "orig_name": Path(file.filename).stem,
            "ext": ext,
            "media_type": media_type,
            "width": meta["width"],
            "height": meta["height"],
            "duration": meta["duration"],
            "fps": meta["fps"],
        }

    return jsonify({
        "file_id": file_id,
        "media_type": media_type,
        "media_url": f"/uploads/{saved_name}",
        "width": meta["width"],
        "height": meta["height"],
        "duration": meta["duration"],
    })


@app.route("/api/process", methods=["POST"])
def process_media():
    payload = request.get_json(silent=True) or {}
    file_id = payload.get("file_id", "")
    mode = payload.get("mode", "ai_lama")
    raw_items = payload.get("items", [])

    if mode not in ALLOWED_MODES:
        return jsonify({"error": "无效的处理模式"}), 400

    with FILE_LOCK:
        info = FILE_INDEX.get(file_id)

    if not info or not info["path"].exists():
        return jsonify({"error": "原文件不存在或已过期，请重新上传"}), 404

    media_type = info["media_type"]

    if media_type == "video" and not check_ffmpeg_installed():
        return jsonify({"error": "服务器未安装 FFmpeg"}), 500
    if mode == "ai_lama" and (not CV2_AVAILABLE or not LAMA_PKG_AVAILABLE):
        return jsonify({"error": "尚未安装 AI 依赖（opencv-python / simple-lama-inpainting），请先执行 pip install -r requirements.txt"}), 400
    if not CV2_AVAILABLE and (media_type == "image" or mode == "smart_removelogo"):
        return jsonify({"error": "尚未安装 opencv-python / Pillow，请先执行 pip install -r requirements.txt"}), 400

    try:
        items = validate_items(raw_items, mode, info["width"], info["height"], media_type)
    except (ValueError, KeyError, TypeError) as exc:
        return jsonify({"error": str(exc)}), 400

    task_id = uuid.uuid4().hex
    safe_stem = "".join(c for c in info["orig_name"] if c.isalnum() or c in "._- ") or "media"

    if media_type == "image":
        out_ext = info["ext"] if info["ext"] in {".png", ".jpg", ".jpeg", ".webp"} else ".png"
        output_filename = f"{safe_stem}_clean_{task_id[:8]}{out_ext}"
    else:
        output_filename = f"{safe_stem}_clean_{task_id[:8]}.mp4"

    output_path = OUTPUT_DIR / output_filename

    with TASKS_LOCK:
        TASKS[task_id] = {
            "status": "processing",
            "progress": 0,
            "stage": "任务初始化...",
            "media_type": media_type,
            "error": None,
            "output_url": None,
            "download_url": None,
        }

    if media_type == "image":
        t = threading.Thread(
            target=run_image_worker,
            args=(task_id, info["path"], output_path, items, mode, info),
            daemon=True,
        )
    elif mode == "ai_lama":
        t = threading.Thread(
            target=run_ai_lama_worker,
            args=(task_id, info["path"], output_path, items, info),
            daemon=True,
        )
    elif mode == "smart_removelogo":
        t = threading.Thread(
            target=run_smart_removelogo_worker,
            args=(task_id, info["path"], output_path, items, info),
            daemon=True,
        )
    else:
        cmd = build_basic_ffmpeg_command(info["path"], output_path, items, mode)
        t = threading.Thread(
            target=run_basic_worker,
            args=(task_id, cmd, info["duration"], output_filename),
            daemon=True,
        )

    t.start()
    return jsonify({"task_id": task_id})


