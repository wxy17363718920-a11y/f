def cleanup_old_files(max_age_seconds=7200):
    now = time.time()
    for folder in (UPLOAD_DIR, OUTPUT_DIR):
        for p in folder.iterdir():
            if p.is_file() and (now - p.stat().st_mtime) > max_age_seconds:
                try:
                    p.unlink()
                except OSError:
                    pass


def parse_fps(rate_str):
    if not rate_str or "/" not in str(rate_str):
        return 0.0
    try:
        a, b = str(rate_str).split("/", 1)
        a_f, b_f = float(a), float(b)
        if b_f > 0:
            return a_f / b_f
    except ValueError:
        pass
    return 0.0


