      border-color: var(--accent);
      color: #67e8f9;
    }

    .tool-btn.active-brush {
      background: rgba(244, 63, 94, 0.16);
      border-color: var(--brush);
      color: #fda4af;
    }

    .tool-btn.active-pan {
      background: rgba(59, 130, 246, 0.18);
      border-color: var(--primary);
      color: #93c5fd;
    }

    .brush-slider-wrap {
      display: none;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--muted);
    }
    .brush-slider-wrap input { width: 85px; accent-color: var(--brush); }

    .auto-mask-toggle {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: #a5f3fc;
      cursor: pointer;
      user-select: none;
      padding: 4px 2px;
    }
    .auto-mask-toggle input { width: 16px; height: 16px; accent-color: var(--accent); }

    .stage-outer {
      display: flex;
      justify-content: center;
      align-items: center;
      background: #06080c;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 8px;
      min-height: 240px;
      max-height: 62vh;
      overflow: hidden;
    }

    .stage-inner {
      position: relative;
      display: inline-block;
      line-height: 0;
      max-width: 100%;
      max-height: calc(62vh - 16px);
    }

    #previewVideo, #previewImage {
      display: block;
      max-width: 100%;
      max-height: calc(62vh - 16px);
      width: auto;
      height: auto;
      border-radius: 4px;
      user-select: none;
      -webkit-user-drag: none;
    }

    #previewImage { display: none; }

    #drawCanvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      cursor: crosshair;
      touch-action: none;
    }

    .mobile-hint {
      font-size: 12px;
      color: var(--muted);
      margin-top: 8px;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 6px;
    }

    .transport {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 10px;
      background: var(--panel-2);
      padding: 9px 12px;
      border-radius: 10px;
      border: 1px solid var(--border);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      min-height: 38px;
      border-radius: 8px;
      padding: 8px 14px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.18s, opacity 0.18s;
      color: var(--text);
      background: var(--panel-2);
      border: 1px solid var(--border);
      text-decoration: none;
    }

    .btn:hover:not(:disabled) { background: #232c3f; }
    .btn:disabled { opacity: 0.45; cursor: not-allowed; }
    .btn-primary { background: var(--primary); border-color: var(--primary); color: #fff; }
    .btn-primary:hover:not(:disabled) { background: var(--primary-hover); }
    .btn-success { background: var(--success); border-color: var(--success); color: #052e16; }
    .btn-sm { min-height: 34px; padding: 5px 10px; font-size: 12px; }
    .btn-danger-ghost {
      min-height: 30px;
      background: transparent;
      border-color: transparent;
      color: #fca5a5;
      padding: 4px 8px;
      font-size: 12px;
    }
    .btn-danger-ghost:hover { background: rgba(239, 68, 68, 0.15); }

    #seekBar { flex: 1; min-width: 80px; accent-color: var(--accent); cursor: pointer; height: 24px; }
    .time-label {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12px;
      color: var(--muted);
      min-width: 96px;
      text-align: right;
    }

    .side-section { margin-bottom: 16px; }
    .side-title {
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .mode-group { display: grid; gap: 8px; }

    .mode-option {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      padding: 10px 12px;
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 9px;
      cursor: pointer;
      transition: border-color 0.15s;
    }

    .mode-option.active {
      border-color: var(--accent);
      background: rgba(6, 182, 212, 0.08);
    }

    .mode-option input { margin-top: 3px; width: 16px; height: 16px; accent-color: var(--accent); }
    .mode-option strong { display: block; font-size: 13px; }
    .mode-option span { display: block; font-size: 12px; color: var(--muted); }
    .tag-rec {
      display: inline-block;
      font-size: 10px;
      padding: 1px 6px;
      border-radius: 4px;
      background: rgba(16, 185, 129, 0.2);
      color: #6ee7b7;
      margin-left: 6px;
    }

    .boxes-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-height: 240px;
      overflow-y: auto;
    }

    .box-empty {
      text-align: center;
      color: var(--muted);
      font-size: 13px;
      padding: 18px 10px;
      background: var(--panel-2);
      border-radius: 8px;
      border: 1px dashed var(--border);
    }

    .box-item {
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 10px;
      font-size: 12px;
    }

    .box-item-head { display: flex; justify-content: space-between; align-items: center; }

    .box-tag {
      display: inline-block;
      background: rgba(6, 182, 212, 0.18);
      color: #67e8f9;
      padding: 2px 7px;
      border-radius: 4px;
      font-weight: 600;
      margin-right: 6px;
    }
    .box-tag.brush { background: rgba(244, 63, 94, 0.18); color: #fda4af; }

    .box-time-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }
    .box-time-row label { display: block; color: var(--muted); font-size: 11px; margin-bottom: 3px; }
    .box-time-row input {
      width: 100%;
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 6px;
      padding: 6px 8px;
      font-size: 13px;
    }

    .progress-wrap {
      display: none;
      margin-top: 12px;
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 9px;
      padding: 12px;
    }

    .progress-bar-bg {
      height: 8px;
      background: var(--bg);
      border-radius: 99px;
      overflow: hidden;
      margin-top: 8px;
    }

    .progress-bar-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--primary), var(--accent));
      transition: width 0.25s;
    }

    .status-msg { margin-top: 10px; font-size: 13px; color: #fca5a5; display: none; }

    .result-card { display: none; margin-top: 16px; }
    .result-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
      flex-wrap: wrap;
      gap: 10px;
    }
    #resultVideo, #resultImage {
      width: 100%;
      max-height: 55vh;
      object-fit: contain;
      background: #000;
      border-radius: 8px;
    }
    #resultImage { display: none; }
    .save-tip { font-size: 12px; color: var(--muted); margin-top: 8px; }

    /* 手机扫码弹窗 */
    .modal-mask {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.72);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 1000;
    }
    .modal-box {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 20px;
      max-width: 360px;
      width: 100%;
      text-align: center;
    }
    .qr-box {
      width: 190px;
      height: 190px;
      margin: 14px auto;
      background: #fff;
      border-radius: 10px;
      padding: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .qr-box img { width: 100%; height: 100%; display: block; }
    .lan-url-pill {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 8px 10px;
      font-family: ui-monospace, monospace;
      font-size: 13px;
      color: #67e8f9;
      word-break: break-all;
      margin-bottom: 12px;
    }

    @media (max-width: 980px) {
      .workspace { grid-template-columns: 1fr; }
    }

    @media (max-width: 640px) {
      .container { padding: 10px; }
      .card { padding: 12px; }
      .header-sub { display: none; }
      .dropzone { padding: 48px 16px; }
      .stage-outer { min-height: 200px; max-height: 48vh; padding: 6px; }
      .stage-inner, #previewVideo, #previewImage { max-height: calc(48vh - 12px); }
      .btn { min-height: 42px; }
      .tool-btn { min-height: 38px; padding: 6px 10px; font-size: 12px; }
      .mode-option { padding: 9px 10px; }
      .mode-option span { font-size: 11px; }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="brand">
        <span>CleanClip Pro</span>
        <span class="brand-badge">视频 & 图片 AI 去水印</span>
      </div>
      <div class="header-right">
        <span class="header-sub">支持手机触屏放大镜 · 局部 LaMa 重建</span>
        <button type="button" class="btn btn-sm" id="mobileAccessBtn">📱 手机访问</button>
      </div>
    </header>

    <div id="envAlert" class="env-alert"></div>

    <div class="workspace">
      <div class="card">
        <input type="file" id="fileInput" accept="video/*,image/*,.mp4,.mov,.webm,.mkv,.jpg,.jpeg,.png,.webp" hidden />

        <div id="dropzone" class="dropzone">
          <div class="dropzone-icon">🎬 🖼️</div>
          <h3>点击选择或拖拽「视频 / 图片」</h3>
          <p>视频支持 MP4 / MOV / WebM · 图片支持 JPG / PNG / WebP</p>
          <span class="dropzone-btn">选择相册视频或图片</span>
          <p id="uploadProgressText" style="margin-top: 12px; color: var(--accent); font-weight: 600;"></p>
        </div>

        <div id="editorArea" class="editor-area">
          <div class="toolbar">
            <div class="tool-group">
              <button type="button" class="tool-btn active-rect" id="toolRectBtn">▭ 框选</button>
              <button type="button" class="tool-btn" id="toolBrushBtn">🖌 画笔</button>
              <button type="button" class="tool-btn" id="toolPanBtn">🖐 滑动</button>
              <label class="auto-mask-toggle" id="autoMaskWrap" title="自动识别视频框内静态水印文字/Logo笔画">
                <input type="checkbox" id="autoMaskCheck" checked />
                <span>智能抠轮廓</span>
              </label>
              <div class="brush-slider-wrap" id="brushSliderWrap">
                <span>粗细</span>
                <input type="range" id="brushSizeInput" min="6" max="50" value="18" />
                <span id="brushSizeVal">18px</span>
              </div>
            </div>
            <div class="tool-group">
              <span id="mediaBadge" style="font-size: 12px; color: var(--muted);"></span>
              <button type="button" class="btn btn-sm" id="undoBtn">↩ 撤销</button>
              <button type="button" class="btn btn-sm" id="reuploadBtn">换文件</button>
            </div>
          </div>

          <div class="stage-outer">
            <div class="stage-inner" id="mediaStage">
              <video id="previewVideo" preload="auto" playsinline webkit-playsinline></video>
              <img id="previewImage" alt="预览图片" />
              <canvas id="drawCanvas"></canvas>
            </div>
          </div>

          <div class="mobile-hint">
            <span id="toolHintText">💡 按住画面拖动框选水印（拖拽时会自动弹出局部放大镜）</span>
          </div>

          <div class="transport" id="transportBar">
            <button type="button" class="btn btn-sm" id="playPauseBtn">▶ 播放</button>
            <input type="range" id="seekBar" min="0" max="1000" value="0" />
            <span class="time-label" id="timeLabel">00:00.0 / 00:00.0</span>
          </div>
        </div>

        <div id="resultCard" class="result-card">
          <div class="result-head">
            <h3 style="font-size: 16px;">✅ 去水印完成</h3>
            <a id="downloadBtn" class="btn btn-success" href="#" download>⬇ 下载文件</a>
          </div>
          <video id="resultVideo" controls playsinline webkit-playsinline></video>
          <img id="resultImage" alt="去水印结果" />
          <p id="saveTip" class="save-tip"></p>
        </div>
      </div>

      <div class="card">
        <div class="side-section">
          <div class="side-title">1. 选择去水印引擎</div>
          <div class="mode-group">
            <label class="mode-option active">
              <input type="radio" name="mode" value="ai_lama" checked />
              <div>
                <strong>AI LaMa 精修重建<span class="tag-rec">推荐</span></strong>
                <span>局部裁剪 + 神经网络纹理脑补（图片约 1 秒出图，视频逐帧精修）</span>
              </div>
            </label>
            <label class="mode-option">
              <input type="radio" name="mode" value="smart_removelogo" />
              <div>
                <strong>极速智能修复</strong>
                <span>视频自动抠轮廓极速擦除；图片快速像素修补</span>
              </div>
            </label>
            <label class="mode-option">
              <input type="radio" name="mode" value="delogo" />
              <div>
                <strong>基础抹除 (Delogo / Inpaint)</strong>
                <span>视频为传统矩形插值；图片为快速修补</span>
              </div>
            </label>
            <label class="mode-option">
              <input type="radio" name="mode" value="blur" />
              <div>
                <strong>高斯模糊 (Blur)</strong>
                <span>强力虚化实心 Logo 或隐私打码</span>
              </div>
            </label>
            <label class="mode-option">
              <input type="radio" name="mode" value="pixelate" />
              <div>
                <strong>像素马赛克 (Mosaic)</strong>
                <span>经典马赛克遮挡</span>
              </div>
            </label>
          </div>
        </div>

        <div class="side-section">
          <div class="side-title">
            <span>2. 选区与涂抹记录 (<span id="boxCount">0</span>)</span>
            <button type="button" class="btn btn-sm" id="clearBoxesBtn">清空</button>
          </div>
          <div id="boxesList" class="boxes-list">
            <div class="box-empty">请先上传视频或图片，在上方用「框选」或「画笔」标记水印</div>
          </div>
        </div>

        <button type="button" id="processBtn" class="btn btn-primary" style="width: 100%; padding: 12px;" disabled>
          开始去除水印
        </button>

        <div id="progressWrap" class="progress-wrap">
          <div style="display: flex; justify-content: space-between; font-size: 13px;">
            <span id="progressLabel">正在处理...</span>
            <span id="progressPct">0%</span>
          </div>
          <div class="progress-bar-bg">
            <div id="progressBarFill" class="progress-bar-fill"></div>
          </div>
        </div>

        <div id="statusMsg" class="status-msg"></div>
      </div>
    </div>
  </div>

  <!-- 手机扫码弹窗 -->
  <div id="mobileModal" class="modal-mask">
    <div class="modal-box">
      <h3 style="font-size: 17px; margin-bottom: 6px;">📱 手机扫码打开网站</h3>
      <p style="font-size: 12px; color: var(--muted);">确保手机和这台 Mac 连接在同一个 Wi-Fi 下</p>
      <div class="qr-box" id="qrBox">
        <img id="qrImg" src="" alt="手机访问二维码" />
      </div>
      <div class="lan-url-pill" id="lanUrlText">读取中...</div>
      <div style="display: flex; gap: 8px; justify-content: center;">
        <button type="button" class="btn btn-primary btn-sm" id="copyLanBtn">复制网址</button>
        <button type="button" class="btn btn-sm" id="closeModalBtn">关闭</button>
      </div>
    </div>
  </div>

  <script>
    const fileInput = document.getElementById("fileInput");
    const dropzone = document.getElementById("dropzone");
    const uploadProgressText = document.getElementById("uploadProgressText");
    const editorArea = document.getElementById("editorArea");
    const previewVideo = document.getElementById("previewVideo");
    const previewImage = document.getElementById("previewImage");
    const transportBar = document.getElementById("transportBar");
    const drawCanvas = document.getElementById("drawCanvas");
    const ctx = drawCanvas.getContext("2d");
    const brushLayer = document.createElement("canvas");
    const brushCtx = brushLayer.getContext("2d");

    const toolRectBtn = document.getElementById("toolRectBtn");
    const toolBrushBtn = document.getElementById("toolBrushBtn");
    const toolPanBtn = document.getElementById("toolPanBtn");
    const toolHintText = document.getElementById("toolHintText");
    const autoMaskWrap = document.getElementById("autoMaskWrap");
    const autoMaskCheck = document.getElementById("autoMaskCheck");
    const brushSliderWrap = document.getElementById("brushSliderWrap");
    const brushSizeInput = document.getElementById("brushSizeInput");
    const brushSizeVal = document.getElementById("brushSizeVal");
    const undoBtn = document.getElementById("undoBtn");
    const reuploadBtn = document.getElementById("reuploadBtn");
    const playPauseBtn = document.getElementById("playPauseBtn");
    const seekBar = document.getElementById("seekBar");
    const timeLabel = document.getElementById("timeLabel");
    const mediaBadge = document.getElementById("mediaBadge");
    const boxesList = document.getElementById("boxesList");
    const boxCount = document.getElementById("boxCount");
    const clearBoxesBtn = document.getElementById("clearBoxesBtn");
    const processBtn = document.getElementById("processBtn");
    const progressWrap = document.getElementById("progressWrap");
    const progressLabel = document.getElementById("progressLabel");
    const progressPct = document.getElementById("progressPct");
    const progressBarFill = document.getElementById("progressBarFill");
    const statusMsg = document.getElementById("statusMsg");
    const resultCard = document.getElementById("resultCard");
    const resultVideo = document.getElementById("resultVideo");
    const resultImage = document.getElementById("resultImage");
    const downloadBtn = document.getElementById("downloadBtn");
    const saveTip = document.getElementById("saveTip");
    const envAlert = document.getElementById("envAlert");

    const mobileAccessBtn = document.getElementById("mobileAccessBtn");
    const mobileModal = document.getElementById("mobileModal");
    const qrBox = document.getElementById("qrBox");
    const qrImg = document.getElementById("qrImg");
    const lanUrlText = document.getElementById("lanUrlText");
    const copyLanBtn = document.getElementById("copyLanBtn");
    const closeModalBtn = document.getElementById("closeModalBtn");

    let mediaMeta = null;
    let items = [];
    let activeTool = "rect"; // "rect" | "brush" | "pan"
    let brushRadiusPx = 18;
    let isDrawing = false;
    let startPt = null;
    let curPt = null;
    let currentRectDraft = null;
    let currentBrushDraft = null;
    let hoverPt = null;
    let pollTimer = null;
    let healthInfo = {};

    fetch("/api/health")
      .then((r) => r.json())
      .then((d) => {
        healthInfo = d;
        const missing = [];
        if (!d.ffmpeg || !d.ffprobe) missing.push("FFmpeg (处理视频必需)");
        if (!d.cv2) missing.push("opencv-python / Pillow");
        if (!d.lama) missing.push("simple-lama-inpainting / torch（如需使用 AI LaMa 引擎）");
        if (missing.length > 0) {
          envAlert.textContent = "环境提示：尚未检测到 " + missing.join("；");
          envAlert.style.display = "block";
        }
        lanUrlText.textContent = d.lan_url || window.location.origin;
        if (!d.qr) {
          qrBox.innerHTML = `<span style="color:#475569;font-size:12px;padding:10px;">未安装 qrcode 库，直接复制下方网址在手机浏览器打开即可</span>`;
        }
      })
      .catch(() => {});

    mobileAccessBtn.addEventListener("click", () => {
      if (healthInfo.qr !== false) {
        qrImg.src = "/api/lan_qr.svg?t=" + Date.now();
      }
      mobileModal.style.display = "flex";
    });
    closeModalBtn.addEventListener("click", () => { mobileModal.style.display = "none"; });
    mobileModal.addEventListener("click", (e) => { if (e.target === mobileModal) mobileModal.style.display = "none"; });
    copyLanBtn.addEventListener("click", async () => {
      const txt = lanUrlText.textContent;
      try {
        await navigator.clipboard.writeText(txt);
        copyLanBtn.textContent = "已复制！";
        setTimeout(() => { copyLanBtn.textContent = "复制网址"; }, 1500);
      } catch (_) {
        alert("请手动复制网址: " + txt);
      }
    });

    function updateToolUI() {
      const isImage = mediaMeta && mediaMeta.media_type === "image";
      toolRectBtn.classList.remove("active-rect");
      toolBrushBtn.classList.remove("active-brush");
      toolPanBtn.classList.remove("active-pan");

      if (activeTool === "rect") {
        toolRectBtn.classList.add("active-rect");
        autoMaskWrap.style.display = isImage ? "none" : "flex";
        brushSliderWrap.style.display = "none";
        drawCanvas.style.pointerEvents = "auto";
        drawCanvas.style.touchAction = "none";
        drawCanvas.style.cursor = "crosshair";
        toolHintText.textContent = "💡 按住拖动框选水印（操作时会自动显示局部放大镜）";
      } else if (activeTool === "brush") {
        toolBrushBtn.classList.add("active-brush");
        autoMaskWrap.style.display = "none";
        brushSliderWrap.style.display = "flex";
        drawCanvas.style.pointerEvents = "auto";
        drawCanvas.style.touchAction = "none";
        drawCanvas.style.cursor = "none";
        toolHintText.textContent = "💡 顺着水印涂抹（需要上下滑动页面时可点「🖐 滑动」）";
      } else {
        toolPanBtn.classList.add("active-pan");
        autoMaskWrap.style.display = "none";
        brushSliderWrap.style.display = "none";
        drawCanvas.style.pointerEvents = "none";
        drawCanvas.style.touchAction = "auto";
        toolHintText.textContent = "🖐 当前为浏览滑动模式，可自由上下滑页面；标记水印请切回「框选」或「画笔」";
      }
      redrawCanvas();
    }

    toolRectBtn.addEventListener("click", () => { activeTool = "rect"; updateToolUI(); });
    toolBrushBtn.addEventListener("click", () => { activeTool = "brush"; updateToolUI(); });
    toolPanBtn.addEventListener("click", () => { activeTool = "pan"; updateToolUI(); });

    brushSizeInput.addEventListener("input", () => {
      brushRadiusPx = parseInt(brushSizeInput.value, 10) || 18;
      brushSizeVal.textContent = `${brushRadiusPx}px`;
      redrawCanvas();
    });

    document.querySelectorAll(".mode-option input").forEach((radio) => {
      radio.addEventListener("change", () => {
        document.querySelectorAll(".mode-option").forEach((el) => el.classList.remove("active"));
        radio.closest(".mode-option").classList.add("active");
      });
    });

    function showError(msg) {
      statusMsg.textContent = msg;
      statusMsg.style.display = msg ? "block" : "none";
    }

    function formatTime(sec) {
      if (!isFinite(sec) || sec < 0) sec = 0;
      const m = Math.floor(sec / 60);
      const s = (sec % 60).toFixed(1).padStart(4, "0");
      return `${String(m).padStart(2, "0")}:${s}`;
    }

    function clamp(val, min, max) {
      return Math.max(min, Math.min(max, val));
    }

    function syncCanvasSize() {
      const rect = drawCanvas.getBoundingClientRect();
      if (rect.width > 0 && rect.height > 0) {
        drawCanvas.width = Math.round(rect.width);
        drawCanvas.height = Math.round(rect.height);
        brushLayer.width = drawCanvas.width;
        brushLayer.height = drawCanvas.height;
        redrawCanvas();
      }
    }

    const resizeObserver = new ResizeObserver(() => syncCanvasSize());
    resizeObserver.observe(drawCanvas);

    function drawBrushStrokeOnLayer(stroke, cw, ch) {
      if (!stroke.points || stroke.points.length === 0) return;
      const r = Math.max(2, stroke.radius_norm * cw);
      brushCtx.strokeStyle = "#f43f5e";
      brushCtx.fillStyle = "#f43f5e";
      brushCtx.lineCap = "round";
      brushCtx.lineJoin = "round";
      brushCtx.lineWidth = r * 2;

      if (stroke.points.length === 1) {
        brushCtx.beginPath();
        brushCtx.arc(stroke.points[0][0] * cw, stroke.points[0][1] * ch, r, 0, Math.PI * 2);
        brushCtx.fill();
      } else {
        brushCtx.beginPath();
        brushCtx.moveTo(stroke.points[0][0] * cw, stroke.points[0][1] * ch);
        for (let i = 1; i < stroke.points.length; i++) {
          brushCtx.lineTo(stroke.points[i][0] * cw, stroke.points[i][1] * ch);
        }
        brushCtx.stroke();
      }
    }

    function drawLoupe(cw, ch) {
      if (!isDrawing || !curPt || !mediaMeta) return;
      const isImage = mediaMeta.media_type === "image";
      const mediaEl = isImage ? previewImage : previewVideo;
      const mediaW = isImage ? mediaEl.naturalWidth : mediaEl.videoWidth;
      const mediaH = isImage ? mediaEl.naturalHeight : mediaEl.videoHeight;
      if (!mediaW || !mediaH) return;
      if (!isImage && mediaEl.readyState < 2) return;

      const loupeSize = Math.min(116, Math.round(Math.min(cw, ch) * 0.42));
      if (loupeSize < 64) return;
      const zoom = 2.2;
      const margin = 10;
      const lx = curPt.x < cw / 2 ? cw - loupeSize - margin : margin;
      const ly = curPt.y < ch / 2 ? ch - loupeSize - margin : margin;

      const nx = curPt.x / cw;
      const ny = curPt.y / ch;
      const sampleW = (loupeSize / zoom) * (mediaW / cw);
      const sampleH = (loupeSize / zoom) * (mediaH / ch);

      const srcX0 = nx * mediaW - sampleW / 2;
      const srcY0 = ny * mediaH - sampleH / 2;
      const srcX1 = srcX0 + sampleW;
      const srcY1 = srcY0 + sampleH;

      const csx = Math.max(0, srcX0);
      const csy = Math.max(0, srcY0);
      const cex = Math.min(mediaW, srcX1);
      const cey = Math.min(mediaH, srcY1);

      ctx.save();
      ctx.beginPath();
      ctx.roundRect ? ctx.roundRect(lx, ly, loupeSize, loupeSize, 10) : ctx.rect(lx, ly, loupeSize, loupeSize);
      ctx.clip();

      ctx.fillStyle = "#06080c";
      ctx.fillRect(lx, ly, loupeSize, loupeSize);

      try {
        if (cex > csx && cey > csy) {
          const dx = lx + ((csx - srcX0) / sampleW) * loupeSize;
          const dy = ly + ((csy - srcY0) / sampleH) * loupeSize;
          const dw = ((cex - csx) / sampleW) * loupeSize;
          const dh = ((cey - csy) / sampleH) * loupeSize;
          ctx.drawImage(mediaEl, csx, csy, cex - csx, cey - csy, dx, dy, dw, dh);
        }
      } catch (_) {}

      const cx = lx + loupeSize / 2;
      const cy = ly + loupeSize / 2;
      if (activeTool === "brush") {
        ctx.beginPath();
        ctx.arc(cx, cy, brushRadiusPx * zoom, 0, Math.PI * 2);
        ctx.strokeStyle = "#fda4af";
        ctx.fillStyle = "rgba(244, 63, 94, 0.25)";
        ctx.fill();
        ctx.lineWidth = 1.5;
        ctx.stroke();
      } else {
        ctx.strokeStyle = "#facc15";
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(cx - 10, cy);
        ctx.lineTo(cx + 10, cy);
        ctx.moveTo(cx, cy - 10);
        ctx.lineTo(cx, cy + 10);
        ctx.stroke();
      }
      ctx.restore();

      ctx.save();
      ctx.strokeStyle = "rgba(255,255,255,0.75)";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.roundRect ? ctx.roundRect(lx, ly, loupeSize, loupeSize, 10) : ctx.rect(lx, ly, loupeSize, loupeSize);
      ctx.stroke();
      ctx.restore();
    }

    function redrawCanvas() {
      const cw = drawCanvas.width;
      const ch = drawCanvas.height;
      if (!cw || !ch) return;

      ctx.clearRect(0, 0, cw, ch);
      brushCtx.clearRect(0, 0, cw, ch);

      let hasBrush = false;
      items.forEach((it) => {
        if (it.type === "brush") {
          drawBrushStrokeOnLayer(it, cw, ch);
          hasBrush = true;
        }
      });
      if (currentBrushDraft) {
        drawBrushStrokeOnLayer(currentBrushDraft, cw, ch);
        hasBrush = true;
      }
      if (hasBrush) {
        ctx.save();
        ctx.globalAlpha = 0.5;
        ctx.drawImage(brushLayer, 0, 0);
        ctx.restore();
      }

      items.forEach((it, idx) => {
        if (it.type !== "rect") return;
        const x = it.nx * cw;
        const y = it.ny * ch;
        const w = it.nw * cw;
        const h = it.nh * ch;

        ctx.fillStyle = "rgba(6, 182, 212, 0.16)";
        ctx.fillRect(x, y, w, h);

        ctx.lineWidth = 2;
        ctx.strokeStyle = "#06b6d4";
        ctx.setLineDash([]);
        ctx.strokeRect(x, y, w, h);

        const label = `#${idx + 1}${it.auto_mask ? " 智能轮廓" : ""}`;
        ctx.font = "bold 11px sans-serif";
        const tw = ctx.measureText(label).width;
        ctx.fillStyle = "#06b6d4";
        ctx.fillRect(x, Math.max(0, y - 19), tw + 10, 19);
        ctx.fillStyle = "#041218";
        ctx.fillText(label, x + 5, Math.max(13, y - 5));
      });

      if (currentRectDraft) {
        const x = currentRectDraft.nx * cw;
        const y = currentRectDraft.ny * ch;
        const w = currentRectDraft.nw * cw;
        const h = currentRectDraft.nh * ch;

        ctx.fillStyle = "rgba(250, 204, 21, 0.18)";
        ctx.fillRect(x, y, w, h);
        ctx.lineWidth = 2;
        ctx.strokeStyle = "#facc15";
        ctx.setLineDash([6, 4]);
        ctx.strokeRect(x, y, w, h);
        ctx.setLineDash([]);
      }

      if (activeTool === "brush" && hoverPt && !isDrawing) {
        ctx.save();
        ctx.beginPath();
        ctx.arc(hoverPt.x, hoverPt.y, brushRadiusPx, 0, Math.PI * 2);
        ctx.strokeStyle = "#fda4af";
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.restore();
      }

      drawLoupe(cw, ch);
    }

    function renderItemsList() {
      boxCount.textContent = items.length;
      processBtn.disabled = !mediaMeta || items.length === 0;

      if (items.length === 0) {
        boxesList.innerHTML = `<div class="box-empty">请在上方画面中使用「框选」或「画笔」标记水印</div>`;
        redrawCanvas();
        return;
      }

      const isVideo = mediaMeta && mediaMeta.media_type === "video";
      boxesList.innerHTML = "";

      items.forEach((it, idx) => {
        const itemEl = document.createElement("div");
        itemEl.className = "box-item";

        const head = document.createElement("div");
        head.className = "box-item-head";

        const left = document.createElement("div");
        const tag = document.createElement("span");
        tag.className = it.type === "brush" ? "box-tag brush" : "box-tag";
        tag.textContent = it.type === "brush" ? `#${idx + 1} 画笔` : `#${idx + 1} 框选`;
        const desc = document.createElement("span");
        desc.style.color = "var(--muted)";
        if (it.type === "brush") {
          desc.textContent = `点数 ${it.points.length}`;
        } else {
          const pxX = Math.round(it.nx * mediaMeta.width);
          const pxY = Math.round(it.ny * mediaMeta.height);
          const pxW = Math.round(it.nw * mediaMeta.width);
          const pxH = Math.round(it.nh * mediaMeta.height);
          desc.textContent = `(${pxX},${pxY}) ${pxW}×${pxH}`;
        }
        left.appendChild(tag);
        left.appendChild(desc);

        const delBtn = document.createElement("button");
        delBtn.type = "button";
        delBtn.className = "btn btn-danger-ghost";
        delBtn.textContent = "删除";
        delBtn.onclick = () => {
          items.splice(idx, 1);
          renderItemsList();
        };

        head.appendChild(left);
        head.appendChild(delBtn);
        itemEl.appendChild(head);

        if (isVideo) {
          const timeRow = document.createElement("div");
          timeRow.className = "box-time-row";

          const startWrap = document.createElement("div");
          const startLbl = document.createElement("label");
          startLbl.textContent = "开始秒数 (留空=全程)";
          const startInput = document.createElement("input");
          startInput.type = "number";
          startInput.step = "0.1";
          startInput.min = "0";
          startInput.placeholder = "例如 0.0";
          startInput.value = it.start ?? "";
          startInput.oninput = (e) => { it.start = e.target.value; };
          startWrap.appendChild(startLbl);
          startWrap.appendChild(startInput);

          const endWrap = document.createElement("div");
          const endLbl = document.createElement("label");
          endLbl.textContent = "结束秒数 (留空=全程)";
          const endInput = document.createElement("input");
          endInput.type = "number";
          endInput.step = "0.1";
          endInput.min = "0";
          endInput.placeholder = "例如 5.0";
          endInput.value = it.end ?? "";
          endInput.oninput = (e) => { it.end = e.target.value; };
          endWrap.appendChild(endLbl);
          endWrap.appendChild(endInput);

          timeRow.appendChild(startWrap);
          timeRow.appendChild(endWrap);
          itemEl.appendChild(timeRow);
        }

        boxesList.appendChild(itemEl);
      });

      redrawCanvas();
    }

    drawCanvas.addEventListener("pointerdown", (e) => {
      if (!mediaMeta || activeTool === "pan") return;
      drawCanvas.setPointerCapture(e.pointerId);
      const rect = drawCanvas.getBoundingClientRect();
      const px = clamp(e.clientX - rect.left, 0, rect.width);
      const py = clamp(e.clientY - rect.top, 0, rect.height);
      hoverPt = { x: px, y: py };
      curPt = { x: px, y: py };
      isDrawing = true;

      if (activeTool === "rect") {
        startPt = { x: px, y: py };
        currentRectDraft = null;
      } else {
        currentBrushDraft = {
          type: "brush",
          points: [[px / rect.width, py / rect.height]],
          radius_norm: brushRadiusPx / rect.width,
          start: "",
          end: "",
        };
      }
      redrawCanvas();
    });

    drawCanvas.addEventListener("pointermove", (e) => {
      if (activeTool === "pan") return;
      const rect = drawCanvas.getBoundingClientRect();
      const curX = clamp(e.clientX - rect.left, 0, rect.width);
      const curY = clamp(e.clientY - rect.top, 0, rect.height);
      hoverPt = { x: curX, y: curY };
      curPt = { x: curX, y: curY };

      if (!isDrawing) {
        if (activeTool === "brush" && e.pointerType === "mouse") redrawCanvas();
        return;
      }

      if (activeTool === "rect" && startPt) {
        const x = Math.min(startPt.x, curX);
        const y = Math.min(startPt.y, curY);
        const w = Math.abs(curX - startPt.x);
        const h = Math.abs(curY - startPt.y);
        currentRectDraft = {
          type: "rect",
          nx: x / rect.width,
          ny: y / rect.height,
          nw: w / rect.width,
          nh: h / rect.height,
          auto_mask: mediaMeta.media_type === "video" ? autoMaskCheck.checked : false,
        };
      } else if (activeTool === "brush" && currentBrushDraft) {
        const nx = curX / rect.width;
        const ny = curY / rect.height;
        const pts = currentBrushDraft.points;
        const last = pts[pts.length - 1];
        const dist = Math.hypot((nx - last[0]) * rect.width, (ny - last[1]) * rect.height);
        if (dist >= 2.5) pts.push([nx, ny]);
      }
      redrawCanvas();
    });

    drawCanvas.addEventListener("pointerleave", () => {
      if (!isDrawing) {
        hoverPt = null;
        redrawCanvas();
      }
    });

    function finishDrawing(e) {
      if (!isDrawing) return;
      isDrawing = false;
      try { drawCanvas.releasePointerCapture(e.pointerId); } catch (_) {}

      if (activeTool === "rect" && currentRectDraft) {
        const rect = drawCanvas.getBoundingClientRect();
        if (currentRectDraft.nw * rect.width >= 6 && currentRectDraft.nh * rect.height >= 6) {
          items.push({ ...currentRectDraft, start: "", end: "" });
          renderItemsList();
        }
      } else if (activeTool === "brush" && currentBrushDraft) {
        items.push(currentBrushDraft);
        renderItemsList();
      }
      currentRectDraft = null;
      currentBrushDraft = null;
      startPt = null;
      curPt = null;
      redrawCanvas();
    }

    drawCanvas.addEventListener("pointerup", finishDrawing);
    drawCanvas.addEventListener("pointercancel", finishDrawing);

    undoBtn.addEventListener("click", () => {
      if (items.length > 0) {
        items.pop();
        renderItemsList();
      }
    });

    clearBoxesBtn.addEventListener("click", () => {
      items = [];
      renderItemsList();
    });

    playPauseBtn.addEventListener("click", () => {
      if (previewVideo.paused) previewVideo.play();
      else previewVideo.pause();
    });

    previewVideo.addEventListener("play", () => { playPauseBtn.textContent = "⏸ 暂停"; });
    previewVideo.addEventListener("pause", () => { playPauseBtn.textContent = "▶ 播放"; });

    previewVideo.addEventListener("loadedmetadata", () => {
      syncCanvasSize();
      timeLabel.textContent = `${formatTime(0)} / ${formatTime(previewVideo.duration)}`;
    });

    previewImage.addEventListener("load", () => {
      syncCanvasSize();
    });

    previewVideo.addEventListener("timeupdate", () => {
      const dur = previewVideo.duration || 1;
      seekBar.value = Math.round((previewVideo.currentTime / dur) * 1000);
      timeLabel.textContent = `${formatTime(previewVideo.currentTime)} / ${formatTime(previewVideo.duration)}`;
    });

    seekBar.addEventListener("input", () => {
      const dur = previewVideo.duration || 0;
      previewVideo.currentTime = (seekBar.value / 1000) * dur;
    });

    dropzone.addEventListener("click", () => fileInput.click());
    reuploadBtn.addEventListener("click", () => fileInput.click());

    dropzone.addEventListener("dragover", (e) => {
      e.preventDefault();
      dropzone.classList.add("dragover");
    });

    dropzone.addEventListener("dragleave", () => dropzone.classList.remove("dragover"));

    dropzone.addEventListener("drop", (e) => {
      e.preventDefault();
      dropzone.classList.remove("dragover");
      if (e.dataTransfer.files.length > 0) handleFileUpload(e.dataTransfer.files[0]);
    });

    fileInput.addEventListener("change", () => {
      if (fileInput.files.length > 0) handleFileUpload(fileInput.files[0]);
    });

    function handleFileUpload(file) {
      showError("");
      resultCard.style.display = "none";
      progressWrap.style.display = "none";
      uploadProgressText.textContent = "正在上传并解析文件...";

      const formData = new FormData();
      formData.append("file", file);

      const xhr = new XMLHttpRequest();
      xhr.open("POST", "/api/upload");

      xhr.upload.onprogress = (e) => {
        if (e.lengthComputable) {
          const pct = Math.round((e.loaded / e.total) * 100);
          uploadProgressText.textContent = `上传中 ${pct}%...`;
        }
      };

      xhr.onload = () => {
        uploadProgressText.textContent = "";
        fileInput.value = "";
        let res = {};
        try { res = JSON.parse(xhr.responseText); } catch (_) {}

        if (xhr.status >= 200 && xhr.status < 300) {
          mediaMeta = res;
          items = [];
          activeTool = "rect";
          dropzone.style.display = "none";
          editorArea.style.display = "block";

          const isImage = res.media_type === "image";
          mediaBadge.textContent = `${isImage ? "图片" : "视频"} · ${res.width}×${res.height}`;

          if (isImage) {
            previewVideo.pause();
            previewVideo.removeAttribute("src");
            previewVideo.load();
            previewVideo.style.display = "none";
            transportBar.style.display = "none";
            previewImage.style.display = "block";
            previewImage.src = res.media_url;
          } else {
            previewImage.style.display = "none";
            previewImage.removeAttribute("src");
            previewVideo.style.display = "block";
            transportBar.style.display = "flex";
            previewVideo.src = res.media_url;
          }

          updateToolUI();
          renderItemsList();
        } else {
          showError(res.error || "上传失败，请检查文件格式");
        }
      };

      xhr.onerror = () => {
        uploadProgressText.textContent = "";
        showError("网络错误，上传失败");
      };

      xhr.send(formData);
    }

    processBtn.addEventListener("click", async () => {
      if (!mediaMeta || items.length === 0) return;
      showError("");
      resultCard.style.display = "none";

      const mode = document.querySelector('input[name="mode"]:checked').value;
      processBtn.disabled = true;
      progressWrap.style.display = "block";
      progressLabel.textContent = "正在提交任务...";
      progressPct.textContent = "0%";
      progressBarFill.style.width = "0%";

      try {
        const resp = await fetch("/api/process", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            file_id: mediaMeta.file_id,
            mode,
            items,
          }),
        });
        const data = await resp.json();
        if (!resp.ok) throw new Error(data.error || "任务创建失败");

        pollStatus(data.task_id);
      } catch (err) {
        showError(err.message);
        progressWrap.style.display = "none";
        processBtn.disabled = false;
      }
    });

    function pollStatus(taskId) {
      if (pollTimer) clearInterval(pollTimer);
      pollTimer = setInterval(async () => {
        try {
          const resp = await fetch(`/api/status/${taskId}`);
          const data = await resp.json();
          if (!resp.ok) throw new Error(data.error || "查询状态失败");

          if (data.status === "processing") {
            progressLabel.textContent = data.stage || "正在处理...";
            progressPct.textContent = `${data.progress}%`;
            progressBarFill.style.width = `${data.progress}%`;
          } else if (data.status === "done") {
            clearInterval(pollTimer);
            progressPct.textContent = "100%";
            progressBarFill.style.width = "100%";
            progressLabel.textContent = data.stage || "处理完成！";
            processBtn.disabled = false;

            if (data.media_type === "image") {
              resultVideo.pause();
              resultVideo.style.display = "none";
              resultImage.style.display = "block";
              resultImage.src = data.output_url;
              downloadBtn.textContent = "⬇ 下载无水印图片";
              saveTip.textContent = "📱 手机用户提示：长按上方图片可以直接「存储到照片」；视频点下载后会保存到「文件」App。";
            } else {
              resultImage.style.display = "none";
              resultVideo.style.display = "block";
              resultVideo.src = data.output_url;
              downloadBtn.textContent = "⬇ 下载无水印视频";
              saveTip.textContent = "📱 手机用户提示：点击下载后会保存到手机「文件 / 下载」目录。";
            }
            downloadBtn.href = data.download_url;
            resultCard.style.display = "block";
            resultCard.scrollIntoView({ behavior: "smooth" });
          } else if (data.status === "error") {
            clearInterval(pollTimer);
            progressWrap.style.display = "none";
            processBtn.disabled = false;
            showError(data.error || "处理失败");
          }
        } catch (err) {
          clearInterval(pollTimer);
          progressWrap.style.display = "none";
          processBtn.disabled = false;
          showError(err.message);
        }
      }, 400);
    }
  </script>
</body>
</html>
'''


def main():
    TEMPLATES.mkdir(parents=True, exist_ok=True)
    UPLOADS.mkdir(parents=True, exist_ok=True)
    OUTPUTS.mkdir(parents=True, exist_ok=True)

    (ROOT / "requirements.txt").write_text(REQUIREMENTS_TXT, encoding="utf-8")
    (ROOT / "app.py").write_text(APP_PY, encoding="utf-8")
    (TEMPLATES / "index.html").write_text(INDEX_HTML, encoding="utf-8")

    print(f"已升级为【桌面+手机全端通用版】: {ROOT.resolve()}")
    print("请执行:")
    print(f"  cd {ROOT}")
    print("  pip install -r requirements.txt")
    print("  python app.py")


if __name__ == "__main__":
    main()
