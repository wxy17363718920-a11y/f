        im = ImageOps.exif_transpose(im)
        return {"width": im.width, "height": im.height, "duration": 0.0, "fps": 0.0}


def probe_video(video_path: Path):
    cmd = [
        "ffprobe",
        "-v", "error",
        "-select_streams", "v:0",
        "-show_streams",
        "-show_format",
        "-of", "json",
        str(video_path),
    ]
    res = subprocess.run(cmd, capture_output=True, text=True, check=True)
    data = json.loads(res.stdout)
    streams = data.get("streams") or []
    if not streams:
        raise ValueError("文件中未检测到视频流")

    stream = streams[0]
    width = int(stream["width"])
    height = int(stream["height"])

    rotation = 0
    tags = stream.get("tags") or {}
    if "rotate" in tags:
        try:
            rotation = int(float(tags["rotate"]))
        except ValueError:
            pass
    for sd in stream.get("side_data_list") or []:
        if "rotation" in sd:
            try:
                rotation = int(float(sd["rotation"]))
            except ValueError:
                pass

    if abs(rotation) % 180 == 90:
        width, height = height, width

    duration = 0.0
    for src in (stream.get("duration"), (data.get("format") or {}).get("duration")):
        if src is not None:
            try:
                duration = float(src)
                break
            except ValueError:
                pass

    fps = parse_fps(stream.get("avg_frame_rate")) or parse_fps(stream.get("r_frame_rate"))
    if fps < 1.0 or fps > 120.0:
        fps = 30.0

    return {"width": width, "height": height, "duration": duration, "fps": fps}


def parse_time_window(item, is_image=False):
    if is_image:
        return None, None, None

    start = item.get("start")
    end = item.get("end")
    has_start = start is not None and str(start).strip() != ""
    has_end = end is not None and str(end).strip() != ""

    s_val = None
    e_val = None
    if has_start:
        s_val = max(0.0, float(start))
    if has_end:
        e_val = max(0.0, float(end))
    if s_val is not None and e_val is not None and e_val <= s_val:
        raise ValueError("结束时间必须大于开始时间")

    enable_expr = None
    if s_val is not None and e_val is not None:
        enable_expr = f"between(t,{s_val:.3f},{e_val:.3f})"
    elif s_val is not None:
        enable_expr = f"gte(t,{s_val:.3f})"
    elif e_val is not None:
        enable_expr = f"lte(t,{e_val:.3f})"

    return s_val, e_val, enable_expr


def validate_items(raw_items, mode, width, height, media_type):
    if not isinstance(raw_items, list) or not raw_items:
        raise ValueError("请至少框选或涂抹一个水印区域")
    if len(raw_items) > 60:
        raise ValueError("单次最多支持 60 个选区或笔画")
    if width < 4 or height < 4:
        raise ValueError("媒体分辨率过小")

    is_image = media_type == "image"
    parsed = []
    for it in raw_items:
        itype = it.get("type", "rect")
        s_val, e_val, enable_expr = parse_time_window(it, is_image=is_image)

        if itype == "brush":
            if (not is_image) and mode in {"delogo", "blur", "pixelate"}:
                raise ValueError("视频的基础矩形模式不支持自由画笔，请切换「AI LaMa 精修」或「极速智能修复」模式")
            pts = it.get("points") or []
            if not pts:
                continue
            clean_pts = [[max(0.0, min(1.0, float(p[0]))), max(0.0, min(1.0, float(p[1])))] for p in pts]
            radius_norm = max(0.002, min(0.2, float(it.get("radius_norm", 0.02))))
            parsed.append({
                "type": "brush",
                "points": clean_pts,
                "radius_norm": radius_norm,
                "start": s_val,
                "end": e_val,
                "enable": enable_expr,
            })
        else:
            nx = float(it["nx"])
            ny = float(it["ny"])
            nw = float(it["nw"])
            nh = float(it["nh"])
            x = int(round(nx * width))
            y = int(round(ny * height))
            w = int(round(nw * width))
            h = int(round(nh * height))

            if (not is_image) and mode == "delogo":
                x = max(1, min(x, width - 3))
                y = max(1, min(y, height - 3))
                w = max(2, min(w, width - x - 1))
                h = max(2, min(h, height - y - 1))
            else:
                x = max(0, min((x // 2) * 2, width - 2))
                y = max(0, min((y // 2) * 2, height - 2))
                w = max(2, min(((w + 1) // 2) * 2, ((width - x) // 2) * 2))
                h = max(2, min(((h + 1) // 2) * 2, ((height - y) // 2) * 2))

            parsed.append({
                "type": "rect",
                "x": x,
                "y": y,
                "w": w,
                "h": h,
                "auto_mask": False if is_image else bool(it.get("auto_mask", True)),
                "start": s_val,
                "end": e_val,
                "enable": enable_expr,
            })

    if not parsed:
        raise ValueError("未检测到有效的水印选区")
    return parsed


def draw_brush_on_mask(mask, item, width, height):
    radius_px = max(2, int(round(item["radius_norm"] * width)))
    pts = [
        (
            int(round(p[0] * (width - 1))),
            int(round(p[1] * (height - 1))),
        )
        for p in item["points"]
    ]
    if len(pts) == 1:
        cv2.circle(mask, pts[0], radius_px, 255, -1)
    elif len(pts) > 1:
        tmp = np.zeros_like(mask)
        for j in range(len(pts) - 1):
            cv2.line(tmp, pts[j], pts[j + 1], 255, thickness=radius_px * 2, lineType=cv2.LINE_AA)
        mask[tmp > 127] = 255


def sample_crop_frames_gray(input_path: Path, x: int, y: int, w: int, h: int, t_start: float, t_end: float, num_samples: int = 18):
    span = max(0.2, t_end - t_start)
    timestamps = [t_start + (i + 0.5) * span / num_samples for i in range(num_samples)]
    frames = []
    expected = w * h
    for ts in timestamps:
        cmd = [
            "ffmpeg", "-v", "error",
            "-ss", f"{ts:.3f}",
            "-i", str(input_path),
            "-frames:v", "1",
            "-vf", f"crop=w={w}:h={h}:x={x}:y={y}",
            "-f", "rawvideo",
            "-pix_fmt", "gray",
            "pipe:1",
        ]
        res = subprocess.run(cmd, capture_output=True)
        if res.returncode == 0 and len(res.stdout) >= expected:
            arr = np.frombuffer(res.stdout[:expected], dtype=np.uint8).reshape((h, w))
            frames.append(arr.astype(np.float32))
    return frames


def compute_static_watermark_mask(frames, w: int, h: int):
    if len(frames) < 4:
        return np.full((h, w), 255, dtype=np.uint8)

    grads = []
    for f in frames:
        gx = cv2.Sobel(f, cv2.CV_32F, 1, 0, ksize=3)
        gy = cv2.Sobel(f, cv2.CV_32F, 0, 1, ksize=3)
        grads.append(np.hypot(gx, gy))

    grad_stack = np.stack(grads, axis=0)
    static_grad = np.percentile(grad_stack, 35, axis=0)

    noise_floor = float(np.percentile(static_grad, 20))
    thresh = max(18.0, noise_floor * 2.4 + 10.0)
    edge_mask = (static_grad > thresh).astype(np.uint8) * 255

    k_close = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
    k_dilate = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
    closed = cv2.morphologyEx(edge_mask, cv2.MORPH_CLOSE, k_close)
    dilated = cv2.dilate(closed, k_dilate, iterations=1)

    ratio = float(np.count_nonzero(dilated)) / float(w * h)
    if ratio < 0.015 or ratio > 0.85:
        return np.full((h, w), 255, dtype=np.uint8)
    return dilated


def build_item_masks(input_path: Path, items, vid_w: int, vid_h: int, duration: float):
    prepared = []
    for it in items:
        full_mask = np.zeros((vid_h, vid_w), dtype=np.uint8)
        if it["type"] == "brush":
            draw_brush_on_mask(full_mask, it, vid_w, vid_h)
        else:
            x, y, w, h = it["x"], it["y"], it["w"], it["h"]
            if it["auto_mask"] and duration > 0.4:
                t0 = it["start"] if it["start"] is not None else 0.0
                t1 = it["end"] if it["end"] is not None else duration
                t1 = min(duration, max(t0 + 0.2, t1))
                frames = sample_crop_frames_gray(input_path, x, y, w, h, t0, t1)
                sub_mask = compute_static_watermark_mask(frames, w, h)
                full_mask[y:y + h, x:x + w] = sub_mask
            else:
                full_mask[y:y + h, x:x + w] = 255

        if np.any(full_mask):
            prepared.append({
                "mask": full_mask,
                "start": it["start"],
                "end": it["end"],
                "enable": it["enable"],
            })
    return prepared


def compute_roi_clusters(combined_mask, width: int, height: int):
    num_labels, _, stats, _ = cv2.connectedComponentsWithStats(combined_mask, connectivity=8)
    raw_rois = []
    for lbl in range(1, num_labels):
        rx = int(stats[lbl, cv2.CC_STAT_LEFT])
        ry = int(stats[lbl, cv2.CC_STAT_TOP])
        rw = int(stats[lbl, cv2.CC_STAT_WIDTH])
        rh = int(stats[lbl, cv2.CC_STAT_HEIGHT])
        if rw <= 0 or rh <= 0:
            continue
        pad = max(48, min(140, max(rw, rh) // 2))
        x1 = max(0, rx - pad)
        y1 = max(0, ry - pad)
        x2 = min(width, rx + rw + pad)
        y2 = min(height, ry + rh + pad)
        raw_rois.append([x1, y1, x2, y2])

    merged = []
    for box in raw_rois:
        placed = False
        for m in merged:
            if not (box[2] < m[0] or box[0] > m[2] or box[3] < m[1] or box[1] > m[3]):
                m[0] = min(m[0], box[0])
                m[1] = min(m[1], box[1])
                m[2] = max(m[2], box[2])
                m[3] = max(m[3], box[3])
                placed = True
                break
        if not placed:
            merged.append(box)

    changed = True
    while changed and len(merged) > 1:
        changed = False
        next_merged = []
        while merged:
            cur = merged.pop(0)
            i = 0
            while i < len(merged):
                other = merged[i]
                if not (cur[2] < other[0] or cur[0] > other[2] or cur[3] < other[1] or cur[1] > other[3]):
                    cur = [min(cur[0], other[0]), min(cur[1], other[1]), max(cur[2], other[2]), max(cur[3], other[3])]
                    merged.pop(i)
                    changed = True
                else:
                    i += 1
            next_merged.append(cur)
        merged = next_merged

    clusters = []
    k_feather = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
    k_ctx = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (21, 21))

    for x1, y1, x2, y2 in merged:
        roi_mask = combined_mask[y1:y2, x1:x2]
        dilated = cv2.dilate(roi_mask, k_feather, iterations=1)
        blurred = cv2.GaussianBlur(dilated, (7, 7), 0)
        alpha_u8 = np.maximum(roi_mask, blurred)
        alpha = (alpha_u8.astype(np.float32) / 255.0)[..., None]

        ctx_dilated = cv2.dilate(roi_mask, k_ctx, iterations=1)
        ctx_ring = (ctx_dilated > 0) & (roi_mask == 0)

        clusters.append({
            "x1": x1, "y1": y1, "x2": x2, "y2": y2,
            "roi_mask": roi_mask,
            "alpha": alpha,
            "ctx_ring": ctx_ring,
        })
    return clusters


def run_image_worker(task_id: str, input_path: Path, output_path: Path, items, mode: str, meta):
    try:
        if not CV2_AVAILABLE:
            raise RuntimeError("缺少 opencv-python / numpy / Pillow 依赖")

        with TASKS_LOCK:
            TASKS[task_id]["stage"] = "正在读取图片并构建修复遮罩..."
            TASKS[task_id]["progress"] = 15

        with Image.open(input_path) as im:
            im = ImageOps.exif_transpose(im).convert("RGB")
            orig_rgb = np.array(im)

        img_h, img_w = orig_rgb.shape[:2]
        combined_mask = np.zeros((img_h, img_w), dtype=np.uint8)
        for it in items:
            if it["type"] == "brush":
                draw_brush_on_mask(combined_mask, it, img_w, img_h)
            else:
                x, y, w, h = it["x"], it["y"], it["w"], it["h"]
                combined_mask[y:y + h, x:x + w] = 255

        if not np.any(combined_mask):
            raise RuntimeError("未检测到有效水印遮罩")

        out_rgb = orig_rgb.copy()

        if mode == "ai_lama":
            with TASKS_LOCK:
                TASKS[task_id]["stage"] = "正在加载 LaMa AI 模型（首次需下载约 200MB 权重）..."
                TASKS[task_id]["progress"] = 35
            lama = get_lama_model()

            with TASKS_LOCK:
                TASKS[task_id]["stage"] = "正在用 AI 重建被遮挡画面..."
                TASKS[task_id]["progress"] = 65

            clusters = compute_roi_clusters(combined_mask, img_w, img_h)
            for c in clusters:
                x1, y1, x2, y2 = c["x1"], c["y1"], c["x2"], c["y2"]
                orig_roi = out_rgb[y1:y2, x1:x2]
                out_pil = lama(Image.fromarray(orig_roi), Image.fromarray(c["roi_mask"]))
                repaired_roi = np.array(out_pil.convert("RGB"))
                rh, rw = orig_roi.shape[:2]
                if repaired_roi.shape[0] != rh or repaired_roi.shape[1] != rw:
                    repaired_roi = cv2.resize(repaired_roi, (rw, rh), interpolation=cv2.INTER_LINEAR)
                alpha = c["alpha"]
                blended = (
                    alpha * repaired_roi.astype(np.float32)
                    + (1.0 - alpha) * orig_roi.astype(np.float32)
                ).clip(0, 255).astype(np.uint8)
                out_rgb[y1:y2, x1:x2] = blended

        elif mode in {"smart_removelogo", "delogo"}:
            with TASKS_LOCK:
                TASKS[task_id]["stage"] = "正在执行图像快速修复..."
                TASKS[task_id]["progress"] = 60
            orig_bgr = cv2.cvtColor(orig_rgb, cv2.COLOR_RGB2BGR)
            repaired_bgr = cv2.inpaint(orig_bgr, combined_mask, 5, cv2.INPAINT_TELEA)
            out_rgb = cv2.cvtColor(repaired_bgr, cv2.COLOR_BGR2RGB)

        elif mode == "blur":
            with TASKS_LOCK:
                TASKS[task_id]["stage"] = "正在执行高斯模糊..."
                TASKS[task_id]["progress"] = 60
            blurred = cv2.GaussianBlur(orig_rgb, (39, 39), 0)
            k_feather = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
            dilated = cv2.dilate(combined_mask, k_feather, iterations=1)
            soft = np.maximum(combined_mask, cv2.GaussianBlur(dilated, (7, 7), 0))
            alpha = (soft.astype(np.float32) / 255.0)[..., None]
            out_rgb = (
                alpha * blurred.astype(np.float32) + (1.0 - alpha) * orig_rgb.astype(np.float32)
            ).clip(0, 255).astype(np.uint8)

        elif mode == "pixelate":
            with TASKS_LOCK:
                TASKS[task_id]["stage"] = "正在生成像素马赛克..."
                TASKS[task_id]["progress"] = 60
            ys, xs = np.where(combined_mask > 0)
            mw = max(1, int(xs.max() - xs.min() + 1))
            mh = max(1, int(ys.max() - ys.min() + 1))
            block = max(8, min(mw, mh) // 8)
            small_w = max(2, img_w // block)
            small_h = max(2, img_h // block)
            pix = cv2.resize(orig_rgb, (small_w, small_h), interpolation=cv2.INTER_NEAREST)
            pix = cv2.resize(pix, (img_w, img_h), interpolation=cv2.INTER_NEAREST)
            mask_bool = combined_mask > 0
            out_rgb[mask_bool] = pix[mask_bool]

        out_pil = Image.fromarray(out_rgb)
        save_kwargs = {}
        ext_low = output_path.suffix.lower()
        if ext_low in {".jpg", ".jpeg"}:
            save_kwargs = {"quality": 95, "subsampling": 0}
        elif ext_low == ".webp":
            save_kwargs = {"quality": 95}
        out_pil.save(output_path, **save_kwargs)

        out_name = output_path.name
        with TASKS_LOCK:
            TASKS[task_id]["status"] = "done"
            TASKS[task_id]["progress"] = 100
            TASKS[task_id]["stage"] = "图片去水印完成！"
            TASKS[task_id]["media_type"] = "image"
            TASKS[task_id]["output_url"] = f"/outputs/{out_name}"
            TASKS[task_id]["download_url"] = f"/outputs/{out_name}?download=1"

    except Exception as exc:
        with TASKS_LOCK:
            TASKS[task_id]["status"] = "error"
            TASKS[task_id]["error"] = str(exc)


def run_ai_lama_worker(task_id: str, input_path: Path, output_path: Path, items, meta):
    vid_w = meta["width"]
    vid_h = meta["height"]
    duration = meta["duration"]
    fps = meta["fps"]

    with TASKS_LOCK:
        TASKS[task_id]["stage"] = "正在智能识别水印精细轮廓..."
        TASKS[task_id]["progress"] = 3

    try:
        if not CV2_AVAILABLE:
            raise RuntimeError("缺少 opencv-python / numpy / Pillow 依赖")

        prepared_items = build_item_masks(input_path, items, vid_w, vid_h, duration)
        if not prepared_items:
            raise RuntimeError("未生成有效的修复遮罩")

        with TASKS_LOCK:
            TASKS[task_id]["stage"] = "正在加载 LaMa AI 模型（首次使用需下载约 200MB 权重）..."
            TASKS[task_id]["progress"] = 8

        lama = get_lama_model()

        total_frames = max(1, int(round(duration * fps))) if duration > 0 else 0
        frame_bytes = vid_w * vid_h * 3
        roi_cache = {}
        temporal_cache = {}

        with tempfile.TemporaryDirectory() as tmpdir:
            enc_log_path = Path(tmpdir) / "enc.log"
            dec_log_path = Path(tmpdir) / "dec.log"

            dec_cmd = [
                "ffmpeg", "-v", "error",
                "-i", str(input_path),
                "-vf", f"fps={fps:.6f}",
                "-f", "rawvideo",
                "-pix_fmt", "bgr24",
                "pipe:1",
            ]
            enc_cmd = [
                "ffmpeg", "-y", "-v", "error",
                "-f", "rawvideo",
                "-pix_fmt", "bgr24",
                "-s", f"{vid_w}x{vid_h}",
                "-r", f"{fps:.6f}",
                "-i", "pipe:0",
                "-i", str(input_path),
                "-vf", "pad=ceil(iw/2)*2:ceil(ih/2)*2",
                "-map", "0:v:0",
                "-map", "1:a?",
                "-c:v", "libx264",
                "-preset", "fast",
                "-crf", "18",
                "-pix_fmt", "yuv420p",
                "-c:a", "aac",
                "-b:a", "192k",
                "-movflags", "+faststart",
                str(output_path),
            ]

            with open(dec_log_path, "w") as dlog, open(enc_log_path, "w") as elog:
                dec_proc = subprocess.Popen(dec_cmd, stdout=subprocess.PIPE, stderr=dlog)
                enc_proc = subprocess.Popen(enc_cmd, stdin=subprocess.PIPE, stderr=elog)

                frame_idx = 0
                while True:
                    raw = dec_proc.stdout.read(frame_bytes)
                    if not raw or len(raw) < frame_bytes:
                        break

                    t_sec = frame_idx / fps
                    active_indices = []
                    for i, pi in enumerate(prepared_items):
                        s, e = pi["start"], pi["end"]
                        if (s is None or t_sec >= s) and (e is None or t_sec <= e):
                            active_indices.append(i)

                    if not active_indices:
                        enc_proc.stdin.write(raw)
                    else:
                        active_key = tuple(active_indices)
                        if active_key not in roi_cache:
                            combined = np.zeros((vid_h, vid_w), dtype=np.uint8)
                            for i in active_indices:
                                combined = cv2.bitwise_or(combined, prepared_items[i]["mask"])
                            roi_cache[active_key] = compute_roi_clusters(combined, vid_w, vid_h)

                        clusters = roi_cache[active_key]
                        frame = np.frombuffer(raw, dtype=np.uint8).reshape((vid_h, vid_w, 3)).copy()

                        for c_idx, c in enumerate(clusters):
                            x1, y1, x2, y2 = c["x1"], c["y1"], c["x2"], c["y2"]
                            orig_roi = frame[y1:y2, x1:x2]
                            cache_id = (active_key, c_idx)

                            repaired_bgr = None
                            t_entry = temporal_cache.get(cache_id)
                            if t_entry is not None and np.any(c["ctx_ring"]):
                                prev_roi, prev_repaired, reuse_cnt = t_entry
                                if reuse_cnt < 15:
                                    diff = np.abs(
                                        orig_roi[c["ctx_ring"]].astype(np.int16)
                                        - prev_roi[c["ctx_ring"]].astype(np.int16)
                                    )
                                    if float(np.mean(diff)) < 1.1:
                                        repaired_bgr = prev_repaired
                                        temporal_cache[cache_id] = (prev_roi, prev_repaired, reuse_cnt + 1)

                            if repaired_bgr is None:
                                roi_rgb = cv2.cvtColor(orig_roi, cv2.COLOR_BGR2RGB)
                                out_pil = lama(Image.fromarray(roi_rgb), Image.fromarray(c["roi_mask"]))
                                out_rgb = np.array(out_pil.convert("RGB"))
                                rh, rw = orig_roi.shape[:2]
                                if out_rgb.shape[0] != rh or out_rgb.shape[1] != rw:
                                    out_rgb = cv2.resize(out_rgb, (rw, rh), interpolation=cv2.INTER_LINEAR)
                                repaired_bgr = cv2.cvtColor(out_rgb, cv2.COLOR_RGB2BGR)
                                temporal_cache[cache_id] = (orig_roi.copy(), repaired_bgr, 0)

                            alpha = c["alpha"]
                            blended = (
                                alpha * repaired_bgr.astype(np.float32)
                                + (1.0 - alpha) * orig_roi.astype(np.float32)
                            ).clip(0, 255).astype(np.uint8)
                            frame[y1:y2, x1:x2] = blended

                        enc_proc.stdin.write(frame.tobytes())

                    frame_idx += 1
                    if frame_idx % 5 == 0 or frame_idx == total_frames:
                        pct = min(98, 10 + int((frame_idx / max(1, total_frames)) * 88)) if total_frames > 0 else 50
                        with TASKS_LOCK:
                            TASKS[task_id]["progress"] = pct
                            if total_frames > 0:
                                TASKS[task_id]["stage"] = f"正在逐帧 AI 修复 ({frame_idx}/{total_frames})..."
                            else:
                                TASKS[task_id]["stage"] = f"正在逐帧 AI 修复 (第 {frame_idx} 帧)..."

                enc_proc.stdin.close()
                dec_ret = dec_proc.wait()
                enc_ret = enc_proc.wait()

            if dec_ret != 0 or enc_ret != 0:
                err_txt = ""
                if enc_log_path.exists():
                    err_txt = enc_log_path.read_text(errors="replace")[-400:]
                raise RuntimeError(f"FFmpeg 编解码异常: {err_txt}")

        out_name = output_path.name
        with TASKS_LOCK:
            TASKS[task_id]["status"] = "done"
            TASKS[task_id]["progress"] = 100
            TASKS[task_id]["stage"] = "AI 精修完成！"
            TASKS[task_id]["media_type"] = "video"
            TASKS[task_id]["output_url"] = f"/outputs/{out_name}"
            TASKS[task_id]["download_url"] = f"/outputs/{out_name}?download=1"
    except Exception as exc:
        with TASKS_LOCK:
            TASKS[task_id]["status"] = "error"
            TASKS[task_id]["error"] = str(exc)


def run_smart_removelogo_worker(task_id: str, input_path: Path, output_path: Path, items, meta):
    vid_w = meta["width"]
    vid_h = meta["height"]
    duration = meta["duration"]

    with TASKS_LOCK:
        TASKS[task_id]["stage"] = "正在自动抠出水印精细轮廓..."
        TASKS[task_id]["progress"] = 5

    try:
        if not CV2_AVAILABLE:
            raise RuntimeError("缺少 opencv-python / numpy 依赖")

        prepared_items = build_item_masks(input_path, items, vid_w, vid_h, duration)
        if not prepared_items:
            raise RuntimeError("未生成有效的修复遮罩")

        grouped = {}
        for pi in prepared_items:
            key = pi["enable"] or "__ALL__"
            if key not in grouped:
                grouped[key] = np.zeros((vid_h, vid_w), dtype=np.uint8)
            grouped[key] = cv2.bitwise_or(grouped[key], pi["mask"])

        with tempfile.TemporaryDirectory() as tmpdir:
            tmp_dir = Path(tmpdir)
            filters = []
            for idx, (en_key, mask_arr) in enumerate(grouped.items()):
                mask_file = tmp_dir / f"mask_{idx}.png"
                cv2.imwrite(str(mask_file), mask_arr)
                f_str = f"removelogo=filename='{mask_file.as_posix()}'"
                if en_key != "__ALL__":
                    f_str += f":enable='{en_key}'"
                filters.append(f_str)

            filters.append("pad=ceil(iw/2)*2:ceil(ih/2)*2")
            cmd = [
                "ffmpeg", "-y",
                "-i", str(input_path),
                "-vf", ",".join(filters),
                "-map", "0:v:0",
                "-map", "0:a?",
                "-c:v", "libx264",
                "-preset", "fast",
                "-crf", "18",
                "-pix_fmt", "yuv420p",
                "-c:a", "aac",
                "-b:a", "192k",
                "-movflags", "+faststart",
                "-progress", "pipe:1",
                "-nostats",
                str(output_path),
            ]
            run_ffmpeg_subprocess(task_id, cmd, duration, output_path.name, "正在用精细轮廓引擎渲染...")
    except Exception as exc:
        with TASKS_LOCK:
            TASKS[task_id]["status"] = "error"
            TASKS[task_id]["error"] = str(exc)


def build_basic_ffmpeg_command(input_path: Path, output_path: Path, items, mode: str):
    base_cmd = ["ffmpeg", "-y", "-i", str(input_path)]
    if mode == "delogo":
        filters = []
        for b in items:
            f = f"delogo=x={b['x']}:y={b['y']}:w={b['w']}:h={b['h']}"
            if b["enable"]:
                f += f":enable='{b['enable']}'"
            filters.append(f)
        filters.append("pad=ceil(iw/2)*2:ceil(ih/2)*2")
        cmd = base_cmd + ["-vf", ",".join(filters), "-map", "0:v:0", "-map", "0:a?"]
    else:
        filter_parts = []
        prev_label = "0:v"
        for i, b in enumerate(items):
            x, y, w, h = b["x"], b["y"], b["w"], b["h"]
            base_lbl = f"base{i}"
            src_lbl = f"src{i}"
            fx_lbl = f"fx{i}"
            out_lbl = f"v{i}"
            filter_parts.append(f"[{prev_label}]split=2[{base_lbl}][{src_lbl}]")
            if mode == "blur":
                filter_parts.append(f"[{src_lbl}]crop=w={w}:h={h}:x={x}:y={y},gblur=sigma=18[{fx_lbl}]")
            else:
                block = max(8, min(w, h) // 6)
                pw = max(2, (w // block) // 2 * 2)
                ph = max(2, (h // block) // 2 * 2)
                filter_parts.append(
                    f"[{src_lbl}]crop=w={w}:h={h}:x={x}:y={y},"
                    f"scale={pw}:{ph}:flags=neighbor,scale={w}:{h}:flags=neighbor[{fx_lbl}]"
                )
            ov = f"[{base_lbl}][{fx_lbl}]overlay=x={x}:y={y}"
            if b["enable"]:
                ov += f":enable='{b['enable']}'"
            ov += f"[{out_lbl}]"
            filter_parts.append(ov)
            prev_label = out_lbl

        filter_parts.append(f"[{prev_label}]pad=ceil(iw/2)*2:ceil(ih/2)*2[outv]")
        cmd = base_cmd + ["-filter_complex", ";".join(filter_parts), "-map", "[outv]", "-map", "0:a?"]

    cmd += [
        "-c:v", "libx264", "-preset", "fast", "-crf", "18", "-pix_fmt", "yuv420p",
        "-c:a", "aac", "-b:a", "192k", "-movflags", "+faststart",
        "-progress", "pipe:1", "-nostats", str(output_path),
    ]
    return cmd


def run_ffmpeg_subprocess(task_id: str, cmd, duration: float, output_filename: str, stage_text: str):
    with TASKS_LOCK:
        TASKS[task_id]["stage"] = stage_text

    tail_logs = []
    proc = subprocess.Popen(
        cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, encoding="utf-8", errors="replace", bufsize=1,
    )
    for raw_line in proc.stdout:
        line = raw_line.strip()
        if not line:
            continue
        if line.startswith("out_time_us="):
            val = line.split("=", 1)[1]
            if val.isdigit() and duration > 0:
                cur_sec = int(val) / 1_000_000.0
                pct = min(99, max(5, int((cur_sec / duration) * 100)))
                with TASKS_LOCK:
                    TASKS[task_id]["progress"] = pct
        elif line == "progress=end":
            with TASKS_LOCK:
                TASKS[task_id]["progress"] = 99
        else:
            tail_logs.append(line)
            if len(tail_logs) > 25:
                tail_logs.pop(0)

    ret = proc.wait()
    with TASKS_LOCK:
        if ret == 0:
            TASKS[task_id]["status"] = "done"
            TASKS[task_id]["progress"] = 100
            TASKS[task_id]["stage"] = "处理完成！"
            TASKS[task_id]["media_type"] = "video"
            TASKS[task_id]["output_url"] = f"/outputs/{output_filename}"
            TASKS[task_id]["download_url"] = f"/outputs/{output_filename}?download=1"
        else:
            TASKS[task_id]["status"] = "error"
            TASKS[task_id]["error"] = "FFmpeg 处理失败: " + " | ".join(tail_logs[-5:])


def run_basic_worker(task_id: str, cmd, duration: float, output_filename: str):
    try:
        run_ffmpeg_subprocess(task_id, cmd, duration, output_filename, "正在渲染处理...")
    except Exception as exc:
        with TASKS_LOCK:
            TASKS[task_id]["status"] = "error"
            TASKS[task_id]["error"] = str(exc)


